{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "okey_aii",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5002",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "additionalWatchFolders": ["src-tauri/locales"]
  },
  "app": {
    "windows": [
      {
        "title": "Translate Bubble",
        "label": "translate_bubble",
        "url": "/translate_bubble",
        "width": 13,
        "height": 13,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "minimizable": false,
        "maximizable": false,
        "focusable": false,
        "shadow": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
